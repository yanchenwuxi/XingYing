<?xml version="1.0" encoding="utf-8"?>
<!-- 影片卡片：圆角海报 + 备注角标 + 片名/年份 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@color/surface_container"
            android:contentDescription="海报"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Corner.Poster" />

        <TextView
            android:id="@+id/tvRemark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_badge"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="88dp"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivResume"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge"
            android:contentDescription="继续播放"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            android:visibility="gone"
            app:tint="@color/text_primary" />

        <!-- 底部细进度条：历史里有进度的条目会显示 -->
        <View
            android:id="@+id/vProgress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="@color/primary"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingTop="6dp"
        android:paddingEnd="2dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingTop="1dp"
        android:paddingEnd="2dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />
</LinearLayout>
