<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：底部三标签（首页/直播/我的）。
  内容区是 Fragment 容器，导航结构由 Activity 统一持有，
  页面之间切换不再走 startActivity，返回栈也更符合直觉。

  筛选入口固定在底部导航栏右上角：只在首页显示，由 MainActivity 按当前 tab
  与 HomeFragment 的筛选能力控制显隐；首页不再占用顶部一行放筛选条。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/fragContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 筛选：底部导航栏右上角。有已选条件时切到高亮底并带角标 -->
        <FrameLayout
            android:id="@+id/btnFilter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_filter_fab"
            android:contentDescription="筛选"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivFilter"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_filter"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvFilterBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_filter_badge"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/on_primary"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextAppearanceActive="@style/BottomNav.Text"
        app:itemTextAppearanceInactive="@style/BottomNav.Text"
        app:itemTextColor="@color/bottom_nav_text"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
